# --- Core ---
DATABASE_URL="postgresql://campaigns:campaigns@localhost:5433/campaigns"
JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN=3600
NODE_ENV=development
PORT=4500
FRONTEND_URL="http://localhost:3200"
API_URL="http://localhost:4500"
CORS_ORIGIN="http://localhost:3200"

# --- Redis / BullMQ ---
REDIS_URL="redis://localhost:6380"

# --- AWS SES / SNS ---
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="replace-with-your-access-key"
AWS_SECRET_ACCESS_KEY="replace-with-your-secret-key"
# ARN of the shared SNS topic all per-company SES configuration sets publish delivery/bounce/complaint events to.
SES_SNS_TOPIC_ARN="arn:aws:sns:us-east-1:123456789012:ses-events"
# Optional override for the BullMQ send-rate limiter; otherwise read from SES GetAccount at boot (falls back to 1/sec, the sandbox default).
SES_MAX_SEND_RATE=
# Shared platform sending domain companies can send from before they verify their own domain.
PLATFORM_SENDING_DOMAIN="mail.okwiyatech.co.ke"

# --- Password reset email (optional; without these, forgot-password returns the link directly in non-production) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
MAIL_FROM=
