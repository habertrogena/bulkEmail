# Production environment file for the VPS, used by docker-compose.deploy.yml.
#
# Copy this to `.env` in the project's VPS directory (/opt/bulk-email/production)
# and fill in every value below by hand. NEVER commit the filled-in file.
#
# Generate every secret with:
#   openssl rand -hex 32
# Do not invent placeholder-looking values that resemble real secrets —
# leave them blank until you've actually generated them.
#
# This project is production-only (no staging), so there is exactly one
# copy of this file, in exactly one VPS directory. It is still structured
# to be fully self-describing (container prefix, network, ports all here)
# so that adding a staging environment later — if that ever happens — would
# only mean a second directory with its own filled-in copy of this file,
# never a change to docker-compose.deploy.yml itself.

# --- Deploy identity (drives container names, network, volumes — see
# docker-compose.deploy.yml) ---
# Must be unique across every project on this VPS. Produces containers named
# bulkmail-prod-api, bulkmail-prod-frontend, bulkmail-prod-admin,
# bulkmail-prod-postgres, bulkmail-prod-redis, and volumes
# bulkmail-prod-postgres-data / bulkmail-prod-redis-data.
CONTAINER_PREFIX=bulkmail-prod
# Must be unique across every project on this VPS — do not reuse CrewOS's or
# Tafuta's network name.
NETWORK_NAME=bulkmail-prod-net
# GitHub Container Registry namespace the images were pushed to
# (ghcr.io/<GHCR_OWNER>/bulk-email-api etc.) — matches the repo owner.
GHCR_OWNER=habertrogena

# --- Ports (host-side; container listens on the same port via the PORT env
# var docker-compose.deploy.yml passes it) ---
# Fixed earlier in this project's own port-conflict pass — cross-checked
# against CrewOS's documented range (Postgres 5434, apps 4101-4113) and
# confirmed not to collide. Do not reuse any port from that range or from
# Tafuta's on this same VPS.
API_PORT=4500
FRONTEND_PORT=3200
ADMIN_PORT=3001

# --- Core ---
JWT_SECRET=                          # openssl rand -hex 32
JWT_EXPIRES_IN=3600
NODE_ENV=production
# REQUIRED in this multi-subdomain deployment. Without it, the login cookie
# is scoped only to the API's own host (bulkmailapi.okwiyatech.co.ke) and is
# never sent to the frontend's or admin app's own Next.js servers on their
# different subdomains — their middleware (proxy.ts) checks this cookie to
# gate protected routes, so it always sees "not logged in" and redirects
# back to /login even right after a successful login. Must be the shared
# parent domain (leading dot) covering every subdomain this app uses.
COOKIE_DOMAIN=.okwiyatech.co.ke
# Comma-separated — both the customer frontend's and the admin app's origins,
# since both call this API and the backend splits this on "," (see
# apps/api/src/main.ts and http-exception.filter.ts).
CORS_ORIGIN="https://bulkmail.okwiyatech.co.ke,https://admin.bulkmail.okwiyatech.co.ke"
FRONTEND_URL="https://bulkmail.okwiyatech.co.ke"
API_URL="https://bulkmailapi.okwiyatech.co.ke"

# --- Database (points at the `postgres` service name, not localhost —
# containers resolve each other by service name on the compose network) ---
POSTGRES_USER=campaigns
POSTGRES_PASSWORD=                   # openssl rand -hex 32
POSTGRES_DB=campaigns
DATABASE_URL="postgresql://campaigns:<POSTGRES_PASSWORD>@postgres:5432/campaigns"

# --- Redis / BullMQ (points at the `redis` service name) ---
REDIS_URL="redis://redis:6379"

# --- AWS SES / SNS ---
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# ARN of the shared SNS topic all per-company SES configuration sets publish
# delivery/bounce/complaint events to.
SES_SNS_TOPIC_ARN=
# Optional override for the BullMQ send-rate limiter; otherwise read from SES
# GetAccount at boot (falls back to 1/sec, the sandbox default).
SES_MAX_SEND_RATE=
# Shared platform sending domain companies can send from before they verify
# their own domain.
PLATFORM_SENDING_DOMAIN="mail.okwiyatech.co.ke"

# --- Password reset email (optional; without these, forgot-password returns
# the link directly in non-production only — in production with these unset,
# the link is silently NOT emailed and NOT returned; see auth.service.ts) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
MAIL_FROM=

# --- NOT set here, on purpose ---
# NEXT_PUBLIC_API_URL is a Next.js build-time value, inlined into the
# frontend/admin JS bundle at `pnpm build` — it does nothing if set at
# container runtime. It's supplied to the build as a GitHub Actions
# `--build-arg` from the PROD_API_URL repository Variable, not from this
# file. See deploy-production.yml and docs/DEPLOYMENT.md.
